[Unit]
Description=L1 Compute Scheduler Real-time Visualization
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/Computing-Power-Scheduling
ExecStart=/usr/bin/env python3 /opt/Computing-Power-Scheduling/webapp/server.py --host 0.0.0.0 --port 8080
Environment=SCHEDULER_MODE=simulation
EnvironmentFile=/etc/l1-scheduler-ui/environment
Restart=always
RestartSec=3
User=l1scheduler

[Install]
WantedBy=multi-user.target
