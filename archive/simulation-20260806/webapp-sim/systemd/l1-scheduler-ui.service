[Unit]
Description=L1 Compute Scheduler Real-time Visualization
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/l1-scheduler-ui
ExecStart=/usr/bin/env python3 /opt/l1-scheduler-ui/server.py --host 0.0.0.0 --port 8080
Environment=SCHEDULER_MODE=simulation
# 部署时替换为随机长令牌；不建议在公网关闭认证。
Environment=SCHEDULER_UI_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_TOKEN
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
